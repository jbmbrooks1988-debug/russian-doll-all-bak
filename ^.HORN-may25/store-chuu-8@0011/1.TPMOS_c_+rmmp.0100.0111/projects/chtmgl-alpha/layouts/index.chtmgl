<scene title="CHTMGL Alpha Test" bg="20,30,40" ui_mode="SOVEREIGN">
    <!-- Static 3D Assets -->
    <sprite id="fuzzball" x="0" y="0" z="0" />
    <sprite id="tree" x="5" y="0" z="5" />

    <!-- Structural UI Overlay -->
    <panel id="sidebar" x="10" y="50" width="200" height="600" color="40,40,60">
        <text label="Sidebar Title" x="10" y="20" />
        <button label="Action 1" x="10" y="50" width="180" height="30" onClick="OP:ACTION1" />
        
        <div id="sub-section" x="10" y="100" width="180" height="200" color="60,60,80">
            <text label="Sub-Section" x="10" y="10" />
            <button label="Deep Button" x="10" y="40" width="160" height="30" onClick="OP:DEEP_ACTION" />
        </div>
    </panel>

    <panel id="bottom-bar" x="220" y="550" width="700" height="150" color="30,30,50">
        <text label="Status: Operational" x="20" y="20" />
        <ul id="horiz-list" x="20" y="50">
            <li label="Item A" onClick="OP:ITEM_A" />
            <li label="Item B" onClick="OP:ITEM_B" />
        </ul>
    </panel>
</scene>
