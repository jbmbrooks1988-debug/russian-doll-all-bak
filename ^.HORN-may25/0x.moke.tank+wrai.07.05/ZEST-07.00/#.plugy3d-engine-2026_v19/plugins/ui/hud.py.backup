"""
HUD UI Plugin
Handles heads-up display elements.
"""

from PySide6.QtGui import QColor

from PySide6.QtCore import QTimer

class HUDPlugin:
    """Plugin for handling HUD elements."""
    def __init__(self, main_app):
        self.main_app = main_app
        self.grid_widget = None
        self.pos_text_element = None
        self.pov_text_element = None
        self.is_initialized = False
        self.initialization_attempts = 0
        self.max_attempts = 20
        self.retry_timer = None
        # Store references to our UI elements for manual updates
        self.ui_elements_added = False

    def initialize(self, voxel_grid_widget):
        """Initialize the HUD plugin."""
        print("Initializing HUD Plugin...")
        # Try to initialize immediately with provided widget
        if voxel_grid_widget:
            self.grid_widget = voxel_grid_widget
            # Also check the main_app for fallback
            if not hasattr(self.grid_widget, 'ui_elements'):
                print("Grid widget doesn't have ui_elements, trying main_app central widget")
                central_widget = self.main_app.centralWidget()
                if central_widget and hasattr(central_widget, 'ui_elements'):
                    self.grid_widget = central_widget
                    print("Using central widget as grid widget")
        
        # Check if we have a valid grid widget
        if self.grid_widget and hasattr(self.grid_widget, 'ui_elements'):
            self._add_hud_elements()
            self.ui_elements_added = True
            self.is_initialized = True
            print("HUD Plugin initialized successfully")
        else:
            # If it fails, start a timer to retry - this handles late binding
            print("Deferring HUD initialization - grid widget not ready yet")
            self.retry_timer = QTimer()
            self.retry_timer.timeout.connect(self._retry_initialize)
            self.retry_timer.start(50)  # Try every 50ms

    def _retry_initialize(self):
        """Retry initializing the HUD elements"""
        self.initialization_attempts += 1
        # Use the same logic as _try_initialize to find the grid widget
        success = self._try_initialize()
        if success:
            self.retry_timer.stop()
            self.is_initialized = True
            print("HUD Plugin initialized successfully after retries")
        elif self.initialization_attempts >= self.max_attempts:
            self.retry_timer.stop()
            print(f"HUD Plugin: Failed to initialize after {self.max_attempts} attempts")

    def _try_initialize(self):
        """Attempt to initialize the HUD elements"""
        # Find the grid widget through main application
        if self.grid_widget and hasattr(self.grid_widget, 'ui_elements'):
            print(f"Found grid widget with {len(self.grid_widget.ui_elements)} existing UI elements")
            self._add_hud_elements()
            self.ui_elements_added = True
            return True
        
        # Check central widget as fallback
        if hasattr(self.main_app, 'centralWidget'):
            central_widget = self.main_app.centralWidget()
            if central_widget and hasattr(central_widget, 'ui_elements'):
                self.grid_widget = central_widget
                if self.grid_widget.ui_elements is not None:
                    print(f"Found grid widget via central widget with {len(self.grid_widget.ui_elements)} existing UI elements")
                    self._add_hud_elements()
                    self.ui_elements_added = True
                    return True
        
        print(f"HUD Plugin: Failed to get grid widget, attempt #{self.initialization_attempts+1}")
        return False

    def _add_hud_elements(self):
        """Add HUD elements to the grid widget."""
        if not self.grid_widget:
            return

        # Import UI classes from the voxel_grid module
        from plugins.core.voxel_grid.voxel_grid import TranslucentRect, TextElement

        print(f"Adding HUD elements to grid widget. Current ui_elements count: {len(self.grid_widget.ui_elements)}")
        
        # Position and size adjustments for better visibility
        # Selector position display
        pos_rect = TranslucentRect(10, 10, 280, 40, opacity=0.6, border_color=(0.8, 0.8, 0.0))
        pos_rect.z_order = 2000  # Very high z-order to ensure it's on top of everything
        pos_rect.element_id = "selector_position_rect"
        self.grid_widget.ui_elements.append(pos_rect)
        
        self.pos_text_element = TextElement(20, 35, "Selector: ", font_size=12, color=QColor(0, 255, 255))
        self.pos_text_element.z_order = 2001  # Even higher than the rectangle
        self.pos_text_element.element_id = "selector_position_text"
        self.grid_widget.ui_elements.append(self.pos_text_element)

        # POV mode display
        pov_rect = TranslucentRect(10, 60, 280, 40, opacity=0.6, border_color=(0.8, 0.8, 0.0))
        pov_rect.z_order = 2000
        pov_rect.element_id = "pov_mode_rect"
        self.grid_widget.ui_elements.append(pov_rect)

        self.pov_text_element = TextElement(20, 85, "POV Mode: ", font_size=12, color=QColor(255, 255, 0))
        self.pov_text_element.z_order = 2001
        self.pov_text_element.element_id = "pov_mode_text"
        self.grid_widget.ui_elements.append(self.pov_text_element)

        # Controls display
        controls_rect = TranslucentRect(10, 110, 280, 60, opacity=0.6, border_color=(0.8, 0.8, 0.0))
        controls_rect.z_order = 2000
        controls_rect.element_id = "controls_rect"
        self.grid_widget.ui_elements.append(controls_rect)

        controls_text1 = TextElement(20, 135, "WASD/QE: Camera | Arrows: Selector", font_size=10, color=QColor(200, 200, 200))
        controls_text1.z_order = 2001
        controls_text1.element_id = "controls_text1"
        self.grid_widget.ui_elements.append(controls_text1)

        controls_text2 = TextElement(20, 155, "Z/X: Selector Up/Down | 0: Cycle POV", font_size=10, color=QColor(200, 200, 200))
        controls_text2.z_order = 2001
        controls_text2.element_id = "controls_text2"
        self.grid_widget.ui_elements.append(controls_text2)
        
        print(f"Added HUD elements. New ui_elements count: {len(self.grid_widget.ui_elements)}")
        
        # Force redraw
        if hasattr(self.grid_widget, 'update'):
            self.grid_widget.update()
        # Also call update_ui_elements if available for compatibility
        if hasattr(self.grid_widget, 'update_ui_elements'):
            self.grid_widget.update_ui_elements()

    def update(self):
        """Update HUD elements with current data."""
        if not self.grid_widget or not self.ui_elements_added:
            return

        if self.pos_text_element:
            pos = self.grid_widget.selector_pos
            self.pos_text_element.text = f"Selector: X:{pos[0]}, Y:{pos[1]}, Z:{pos[2]}"
        
        if self.pov_text_element and self.grid_widget.camera:
            pov_mode_text = self.grid_widget.camera.pov_modes[self.grid_widget.camera.pov_mode]
            self.pov_text_element.text = f"POV Mode: {pov_mode_text}"
        
        # Call update_ui_elements for compatibility with other systems
        if hasattr(self.grid_widget, 'update_ui_elements'):
            self.grid_widget.update_ui_elements()

    def manual_update_hud_elements(self):
        """Manually update HUD elements - for cases where automatic updates fail"""
        if not self.grid_widget or not self.ui_elements_added:
            return
            
        # Manually update the stored references
        if self.pos_text_element:
            pos = self.grid_widget.selector_pos
            self.pos_text_element.text = f"Selector: X:{pos[0]}, Y:{pos[1]}, Z:{pos[2]}"
        
        if self.pov_text_element and self.grid_widget.camera:
            pov_mode_text = self.grid_widget.camera.pov_modes[self.grid_widget.camera.pov_mode]
            self.pov_text_element.text = f"POV Mode: {pov_mode_text}"
        
        # Force redraw
        if hasattr(self.grid_widget, 'update'):
            self.grid_widget.update()
        # Also call update_ui_elements if available for compatibility
        if hasattr(self.grid_widget, 'update_ui_elements'):
            self.grid_widget.update_ui_elements()

# Export the plugin class
Plugin = HUDPlugin
