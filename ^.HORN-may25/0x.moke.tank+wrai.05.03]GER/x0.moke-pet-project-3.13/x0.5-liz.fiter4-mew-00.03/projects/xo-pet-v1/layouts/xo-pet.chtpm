<box title="${app_title}" width="60" height="24">
<module>${module_path}</module>
    <text label=" [ SIM ACTIVE: ${sim_status} (${sim_active}) ]" /><br/>
    <text label=" [ ACTIVE ID: ${active_target_id} ]" /><br/>
    <text label=" [ EPOCH: ${epoch} ]" /><br/>
    <text label=" [ STEPS: ${step_count} ]" /><br/>
    <hr/>
    <text label=" PROJECT CONTROLS:" /><br/>
    ${project_controls}<br/>
    <hr/>
    <text label=" PET SWITCHER:" /><br/>
    ${pet_list}<br/>
    <hr/>
    <text label=" METHODS (${active_target}):" /><br/>
    ${piece_methods}<br/>
    <hr/>
    <text label=" LOG: ${last_response}" /><br/>
    <text label=" TURN SUMMARY: ${turn_summary}" /><br/>
</box>
