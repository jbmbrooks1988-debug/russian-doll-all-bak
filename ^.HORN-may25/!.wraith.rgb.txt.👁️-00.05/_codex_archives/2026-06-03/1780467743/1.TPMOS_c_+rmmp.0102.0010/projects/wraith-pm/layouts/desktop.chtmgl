<window id="wraith_root" title="Wraith PM" width="960" height="540" color="#101820" fg="#E8F1F2">
    <header id="topbar" label="Wraith PM - CHTMGL to Colored ASCII Frames" x="0" y="0" width="960" height="54" color="#243B53" fg="#F7FAFC" />

    <panel id="dock" x="16" y="72" width="220" height="432" color="#1B263B" fg="#DDE7F0" border="#4ECDC4">
        <text id="dock_title" label="Frame Pipeline" x="14" y="14" color="#F7FAFC" />
        <button id="render_now" label="Render Frame" x="14" y="58" width="188" height="36" onClick="COMMAND:OP wraith-pm::render" color="#2D6A4F" fg="#FFFFFF" />
        <button id="toggle_rgb" label="RGB Daemon Later" x="14" y="106" width="188" height="36" onClick="COMMAND:OP wraith-pm::rgb_daemon" color="#5A4FCF" fg="#FFFFFF" />
        <checkbox id="ansi_color" label="ANSI color on" x="14" y="158" checked="true" color="#4ECDC4" fg="#F7FAFC" />
        <slider id="audit_depth" label="Audit depth" x="14" y="208" width="188" height="28" min="0" max="100" value="${audit_depth}" color="#FFD166" fg="#111111" />
        <text id="dock_note" label="Frames and metadata are the product." x="14" y="270" color="#B8C5D6" />
    </panel>

    <panel id="desktop" x="252" y="72" width="692" height="432" color="#172A3A" fg="#E8F1F2" border="#7BDFF2">
        <text id="desktop_title" label="ASCII Desktop Preview" x="18" y="14" color="#F7FAFC" />
        <canvas id="main_canvas" x="18" y="52" width="420" height="238" view_mode="ascii_frame" color="#0B1320" fg="#DDE7F0" border="#6FFFE9">
            <text id="canvas_text" label="CHTMGL parsed by Wraith before GL." x="12" y="18" color="#B8F7D4" />
        </canvas>
        <img id="sample_image" src="assets/sample.ppm" x="464" y="52" width="194" height="104" color="#334155" fg="#F7FAFC" />
        <video id="sample_video" src="assets/sample-video.frames" x="464" y="178" width="194" height="112" color="#3D2C54" fg="#F7FAFC" autoplay="false" />
        <text id="status" label="${status}" x="18" y="318" color="#FFD166" />
        <button id="inspect" label="Inspect Metadata" x="18" y="356" width="176" height="36" onClick="COMMAND:OP wraith-pm::inspect" color="#885A89" fg="#FFFFFF" />
        <button id="mouse_test" label="Mouse Hit Map" x="214" y="356" width="176" height="36" onClick="COMMAND:OP wraith-pm::hitmap" color="#006D77" fg="#FFFFFF" />
    </panel>
</window>
