<panel time_reactive="true">
    <module>system/prisc+x pal/main_loop_chtpm.pal</module>
    <interact src="pieces/apps/player_app/interact_relay.txt" />
    <text label="+==========================================+" /><br/>
    <text label="| PAGE 1  pkg=${pkg_name}                 |" /><br/>
    <text label="+==========================================+" /><br/>
    <cli_io id="ez_trigger" label="Trigger (on_spawn/on_click/parallel)" target_id="ez_trigger" /><br/>
    <button label="Save Trigger" onClick="KEY:5" /><br/>
    <text label="-- COMMANDS --" /><br/>
    ${command_list_rows_1}
    <text label="+==========================================+" /><br/>
    <button label="Back to Pages" href="pieces/chtpm/layouts/event_ez.chtpm" /><br/>
    <text label="${last_message}" /><br/>
</panel>
