# main_loop_chtpm.pal - muchi-pals CHTPM-MODULE VARIANT, modeled
# directly on pal-chain's own pal/main_loop_chtpm.pal (real, live-
# verified precedent for this whole family's href+${piece_methods}
# chtpm standard - see pal-standards.txt sec.6/12/16/18/19). ONE
# persistent process, shared identically by EVERY .chtpm layout's own
# <module> tag - screen switching is chtpm's own real href job, never
# this script's (sec.18); this script never restarts across a
# navigation, only chtpm_parser_pal's own liveness-checked
# launch_module() guard keeps it that way (sec.19). Supersedes this
# project's own earlier interact+module/"Control Pets" version (sec.16
# retired that pattern for pure discrete-menu games like this one, in
# favor of ${piece_methods} - see pal-standards.txt sec.0-CORRECTED
# item 3 and sec.16 for why <module>/<interact> themselves still stay).
#
#   - read_history reads pieces/apps/player_app/interact_relay.txt via
#     the literal-path 3-arg form (x1 = read cursor, never persisted
#     beyond this run - a fresh module launch always starts at 0). See
#     this project's own system/prisc+x.c top-of-file comment for why a
#     SEPARATE file from history.txt is required here (double-dispatch
#     bug, not a style choice).
#   - muchi_menu_input 0, every loop iteration, cheaply re-derives the
#     current screen from pieces/display/current_layout.txt (a genuine
#     no-op when nothing changed - see that op's own header comment),
#     only bumping pieces/display/muchi_screen_changed.txt on a real
#     screen change.
#   - read_pos's own literal-path argument (fixed this same session -
#     see system/prisc+x.c's own "LOCAL FIX" comment on read_pos's
#     parser; it silently ignored any path before this and always
#     measured history.txt instead) gates muchi_compose_frame/hit_frame
#     so idle ticks (~33/sec) don't re-render when nothing happened.
#   - x3/x4 epoch tick counter: carried over UNCHANGED from this
#     project's own original main_loop_chtpm.pal/main_loop.pal (every
#     ~100 loop iterations * ~30ms sleep =~ 3s) - real pet metabolism
#     (hunger/energy/poop, tick_pets.c) must keep advancing regardless
#     of which screen is showing or whether any key was pressed; losing
#     this would have been a real functionality regression, not just a
#     UI reskin.
li x1, 0
li x3, 0
li x4, 100

muchi_compose_frame
hit_frame
read_pos x7, "pieces/display/muchi_screen_changed.txt"

loop:
li x9, 0
muchi_menu_input x9
read_pos x8, "pieces/display/muchi_screen_changed.txt"
beq x7, x8, check_key
addi x7, x8, 0
j render

check_key:
read_history pieces/apps/player_app/interact_relay.txt x2, x1
beq x2, x0, no_key
muchi_menu_input x2
j render

no_key:
addi x3, x3, 1
beq x3, x4, do_tick
j after_tick

do_tick:
tick_pets
li x3, 0
j render

after_tick:
sleep 30000
j loop

render:
muchi_compose_frame
hit_frame
sleep 30000
j loop
