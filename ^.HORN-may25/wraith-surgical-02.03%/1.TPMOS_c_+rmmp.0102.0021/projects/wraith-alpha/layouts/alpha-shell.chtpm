<layout id="wraith_alpha_shell">
    <module>projects/wraith-alpha/manager/+x/wraith-alpha_manager.+x</module>
    <interact src="projects/wraith-alpha/session/history.txt" />
    <panel title="WRAITH ALPHA - DESKTOP">
        <text label="[ KPI 1: Keyboard Nav Proof ]" /><br/>
        <text label="Use arrows to move selector. Windows and controls stay indexable." /><br/>
        <br/>
        <text label="+-WRAITH DESKTOP GUI---------------------------------------------------------------------------+" /><br/>
        <text label="| +-" visibility="${desktop_active_window_visible}" /><button compact="true" label=" ${desktop_active_window_title} " onClick="SET_ACTIVE:1" visibility="${desktop_active_window_visible}" /><text label="------------------------------------------" visibility="${desktop_active_window_visible}" />
        <button compact="true" label="o" onClick="SET_ACTIVE:2" visibility="${desktop_active_window_visible}" />
        <button compact="true" label="${desktop_active_window_collapse_glyph}" onClick="SET_ACTIVE:3" visibility="${desktop_active_window_visible}" />
        <button compact="true" label="x" onClick="SET_ACTIVE:4" visibility="${desktop_active_window_visible}" />
        <text label="-+               |" visibility="${desktop_active_window_visible}" /><br/>
        <text label="| |  [ TERMINAL PROJECT ]                                                                        |" visibility="${desktop_active_window_body_visible}" /><br/>
        <text label="| |                                                                                              |" visibility="${desktop_active_window_body_visible}" /><br/>
        <text label="| |  (launch from dock to open another terminal instance)                                        |" visibility="${desktop_active_window_body_visible}" /><br/>
        <text label="| |                                                                                              |" visibility="${desktop_active_window_body_visible}" /><br/>
        <text label="| +----------------------------------------------------------------------------------------------+               |" visibility="${desktop_active_window_body_visible}" /><br/>
        <text label="| [ TASKBAR ] " />
        <button compact="true" label="Terminal" onClick="SET_ACTIVE:5" />
        <button compact="true" label="${desktop_restore_slot_1_title}" onClick="SET_ACTIVE:6" visibility="${desktop_restore_slot_1_visible}" />
        <button compact="true" label="${desktop_restore_slot_2_title}" onClick="SET_ACTIVE:7" visibility="${desktop_restore_slot_2_visible}" />
        <button compact="true" label="${desktop_restore_slot_3_title}" onClick="SET_ACTIVE:8" visibility="${desktop_restore_slot_3_visible}" />
        <button compact="true" label="${desktop_restore_slot_4_title}" onClick="SET_ACTIVE:9" visibility="${desktop_restore_slot_4_visible}" />
        <button compact="true" label="${desktop_restore_slot_5_title}" onClick="SET_ACTIVE:10" visibility="${desktop_restore_slot_5_visible}" />
        <button compact="true" label="${desktop_restore_slot_6_title}" onClick="SET_ACTIVE:11" visibility="${desktop_restore_slot_6_visible}" />
        <button compact="true" label="${desktop_restore_slot_7_title}" onClick="SET_ACTIVE:12" visibility="${desktop_restore_slot_7_visible}" />
        <button compact="true" label="${desktop_restore_slot_8_title}" onClick="SET_ACTIVE:13" visibility="${desktop_restore_slot_8_visible}" />
        <button compact="true" label="${desktop_restore_slot_9_title}" onClick="SET_ACTIVE:14" visibility="${desktop_restore_slot_9_visible}" />
        <button compact="true" label="${desktop_restore_slot_10_title}" onClick="SET_ACTIVE:15" visibility="${desktop_restore_slot_10_visible}" />
        <button compact="true" label="${desktop_restore_slot_11_title}" onClick="SET_ACTIVE:16" visibility="${desktop_restore_slot_11_visible}" />
        <button compact="true" label="${desktop_restore_slot_12_title}" onClick="SET_ACTIVE:17" visibility="${desktop_restore_slot_12_visible}" />
        <button compact="true" label="${desktop_restore_slot_13_title}" onClick="SET_ACTIVE:18" visibility="${desktop_restore_slot_13_visible}" />
        <button compact="true" label="${desktop_restore_slot_14_title}" onClick="SET_ACTIVE:19" visibility="${desktop_restore_slot_14_visible}" />
        <button compact="true" label="${desktop_restore_slot_15_title}" onClick="SET_ACTIVE:20" visibility="${desktop_restore_slot_15_visible}" />
        <button compact="true" label="${desktop_restore_slot_16_title}" onClick="SET_ACTIVE:21" visibility="${desktop_restore_slot_16_visible}" />
        <button compact="true" label="${desktop_restore_slot_17_title}" onClick="SET_ACTIVE:22" visibility="${desktop_restore_slot_17_visible}" />
        <button compact="true" label="${desktop_restore_slot_18_title}" onClick="SET_ACTIVE:23" visibility="${desktop_restore_slot_18_visible}" />
        <button compact="true" label="${desktop_restore_slot_19_title}" onClick="SET_ACTIVE:24" visibility="${desktop_restore_slot_19_visible}" />
        <button compact="true" label="${desktop_restore_slot_20_title}" onClick="SET_ACTIVE:25" visibility="${desktop_restore_slot_20_visible}" />
        <text label=" |" /><br/>
        <text label="+----------------------------------------------------------------------------------------------+" /><br/>
        <br/>
        <text label="Desktop Mode: ${desktop_mode}" /><br/>
        <text label="Open Windows: ${desktop_window_count}" /><br/>
        <text label="Focused Window: ${desktop_focused_window_title}" /><br/>
        <text label="Window Mode: ${desktop_active_window_mode}" /><br/>
        <br/>
        <text label="[ DESKTOP DEBUG ]" /><br/>
        <text label="Manager Index: ${active_gui_index}" /><br/>
        <text label="Manager Key:   ${current_key_label}" /><br/>
        <text label="Manager Mouse: X:${mouse_x} Y:${mouse_y} B:${mouse_btn}" /><br/>
        <br/>
        <text label="[ PARSER BYPASS DEBUG ]" /><br/>
        <text label="RAW: ${PARSER_KBD_DEBUG}" /><br/>
    </panel>
</layout>
