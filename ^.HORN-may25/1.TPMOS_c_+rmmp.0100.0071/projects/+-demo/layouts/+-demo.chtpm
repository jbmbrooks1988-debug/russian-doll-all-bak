<panel>
    <text label="╔═══════════════════════════════════════════════════════════╗" /><br/>
    <text label="║                  +-DEMO PROJECT STATIC LAYOUT             ║" /><br/>
    <text label="╠═══════════════════════════════════════════════════════════╣" /><br/>
    <text label="║ This is a basic static layout.                            ║" /><br/>
    <text label="║ It demonstrates how a layout file opens without a         ║" /><br/>
    <text label="║ dynamic manager.                                        ║" /><br/>
    <text label="║                                                           ║" /><br/>
    <text label="║ For future steps, we can add functionality.               ║" /><br/>
    <text label="╚═══════════════════════════════════════════════════════════╝" /><br/>
    
    <button label="[dir1/][-] Dir1" id="dir1">
        <br/>
        <button label="[2.txt] file" id="file2" /><br/>
        <button label="[3.txt] file" id="file3" /><br/>
        <button label="[subdir/][+] Subdir" id="subdir4">
            <br/>
            <button label="[5.txt] file" id="file5" /><br/>
        </button><br/>
    </button><br/>
    
    <button label="[dir2/][-] Dir2" id="dir2">
        <br/>
        <button label="[7.txt] file" id="file7" /><br/>
    </button><br/>

    <text label="╠═══════════════════════════════════════════════════════════╣" /><br/>
    <text label="║             ACTIVATION SUBMENU DESIGN OPTION              ║" /><br/>
    <text label="╠═══════════════════════════════════════════════════════════╣" /><br/>
    <button label="Menu A (Press Enter to Activate)" onClick="ACTIVATE" id="menu_a">
        <br/>
        <button label="[Back]" onClick="BACK" id="back_a" /><br/>
        <button label="Sub-item 1" onClick="KEY:1" id="sub1" /><br/>
        <button label="Sub-item 2" onClick="KEY:2" id="sub2" /><br/>
        <button label="Nested Menu (Enter to Activate)" onClick="ACTIVATE" id="nested_menu">
            <br/>
            <button label="[Back]" onClick="BACK" id="back_nested" /><br/>
            <button label="Nested Item 1" onClick="KEY:3" id="nested1" /><br/>
        </button><br/>
    </button><br/>
    </panel>
