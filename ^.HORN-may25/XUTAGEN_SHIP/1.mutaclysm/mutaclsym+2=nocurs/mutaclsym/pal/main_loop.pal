# mutaclsym main loop.
# x1 = read cursor into pieces/apps/player_app/history.txt (byte offset)
# x2 = last key read (0 = nothing new)
# x9 = 'q' (113), the quit sentinel keyboard_input.c also stops on
li x1, 0
li x9, 113

loop:
read_history x2, x1
beq x2, x0, no_key
beq x2, x9, quit
move_player x2
end_turn
compose_frame
hit_frame
no_key:
sleep 30000
j loop

quit:
halt
